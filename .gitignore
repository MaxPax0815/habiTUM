#################################################
# React / Vite .gitignore template
# Generated by ChatGPT
# Last updated: 2024-06
# Adjust as needed for specific project setup
#################################################

# Dependencies
node_modules/

# Production build
build/
dist/

# Environment variables #! We should not have any .env files tho. 
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Testing / coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Vite / React cache
.vite/

# TypeScript
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# Optional: keep shared VS Code settings if your team uses them
# !.vscode/settings.json
# !.vscode/extensions.json

# npm package lock
# Keep package-lock.json committed for npm projects
# package-lock.json should NOT be ignored

# Temporary files
tmp/
temp/

# Storybook build output, if used
storybook-static/

# Cypress / Playwright test artifacts, if used
cypress/videos/
cypress/screenshots/
playwright-report/
test-results/

# Firebase / deployment, if used
.firebase/
.vercel/
.netlify/