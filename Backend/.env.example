# Copy this file to .env and fill in real values. .env is gitignored; this file is not,
# so it must never contain a real credential.
#
#   cp Backend/.env.example Backend/.env

# Port the Express server listens on.
PORT=4000

# MongoDB connection string, including the database password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Signs and verifies every auth token. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Stripe test-mode secret key, from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Verifies incoming Stripe webhook signatures. Printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional — these have committed defaults in config.js and are not secret.
# STRIPE_PREMIUM_PRICE_ID=
# STRIPE_MANAGER_BASE_PRICE_ID=
# STRIPE_MANAGER_COMMUNITY_SLOT_PRICE_ID=
# CLIENT_URL=http://localhost:3000
